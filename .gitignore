# Build outputs
build/
bench/build/
bench/*.3dsx
bench/*.elf
bench/*.smdh
bench/results/
core/build/
core/out/
*.o
*.d

# Built test programs (rebuilt by gc-tests/build_examples.sh)
gc-tests/examples-dol/

# Game data never goes in the repository
*.iso
*.gcm
*.nkit.*
*.rvz
*.wbfs
*.ciso
core/host3ds/build/
core/host3ds/build-*/
core/build-swap/
core/host3ds/romfs/
core/host3ds/*.3dsx
core/host3ds/*.elf
core/host3ds/*.smdh
core/host3ds/*.map
core/build-arm/

# Dev relay access token (core/tools/relay.sh, sdmc:/gc3ds/relay.txt): never committed
core/host3ds/relay.txt
core/build-arm*/

core/tools/__pycache__/

# Reference relay server state (tools/relay-server)
relay-data/

# Ahead-of-time translated game code (core/tools/aot/ppc2c.py): derived from the user's own disc, never committed
core/src/aotgen/
core/tools/qemu-plugins/*.so

# Scratch scripts and bytecode from measuring sessions (the two tracked _*.sh files stay tracked)
**/__pycache__/
core/tools/_*

# core/host3ds/build.sh writes this: the build's commit, embedded in the perf.csv header
core/host3ds/version.inc
core/host3ds/version.inc.new
