; gcbench: the minimal shader plus 128 extra MAD instructions (vertex-shader cost per instruction, test G1).
.fvec projection[4]

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mul outclr, inv255, inclr
	mov outtc0, intc
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
	mad r3, r3, r4, r5
