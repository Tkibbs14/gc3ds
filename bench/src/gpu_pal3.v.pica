; gcbench: matrix-palette shader with the palette offset packed into position.w (test G2b: 3 attributes, not 4).
; The index rides in the position attribute, which the hardware loads anyway.
; Inputs: v0 position xyz + palette offset in w (float), v1 color (u8x4), v2 uv (float).

.fvec projection[4]
.fvec pal[84]

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2

.proc main
	mova a0.x, inpos.wwww
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, pal[a0.x], r0
	dp4 r1.y, pal[a0.x+1], r0
	dp4 r1.z, pal[a0.x+2], r0
	mov r1.w, ones

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul outclr, inv255, inclr
	mov outtc0, intc
	end
.end
