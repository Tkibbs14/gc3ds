; gcbench GPU module: heavy vertex shader approximating GameCube hardware T&L.
; modelview + projection, normal matrix, normalize, 4 directional diffuse lights (dot, max, accumulate),
; ambient, multiplied by the per-vertex color, clamped.
; Inputs: v0 position xyz, v1 color (u8x4, 0..255), v2 uv, v3 normal xyz (all float except color).

.fvec projection[4], modelView[4], nrmMtx[3]
.fvec lightDir[4], lightClr[4], ambient

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  zeros  myconst.xxxx
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2
.alias innrm v3

.proc main
	; position: object -> view -> clip
	mov r0.xyz, inpos
	mov r0.w,   ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; normal: transform by the normal matrix, then normalize
	dp3 r2.x, nrmMtx[0], innrm
	dp3 r2.y, nrmMtx[1], innrm
	dp3 r2.z, nrmMtx[2], innrm
	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2.xyz, r3.xxx

	; 4 directional lights: acc += lightClr[i] * max(0, dot(N, L[i]))
	mov r4, ambient
	dp3 r5.x, lightDir[0], r2
	max r5.x, zeros, r5.x
	mad r4, r5.xxxx, lightClr[0], r4
	dp3 r5.x, lightDir[1], r2
	max r5.x, zeros, r5.x
	mad r4, r5.xxxx, lightClr[1], r4
	dp3 r5.x, lightDir[2], r2
	max r5.x, zeros, r5.x
	mad r4, r5.xxxx, lightClr[2], r4
	dp3 r5.x, lightDir[3], r2
	max r5.x, zeros, r5.x
	mad r4, r5.xxxx, lightClr[3], r4

	; modulate by the per-vertex material color, clamp to 1
	mul r6, inv255, inclr
	mul r4, r4, r6
	min outclr, ones, r4

	mov outtc0, intc
	end
.end
