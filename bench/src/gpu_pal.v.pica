; gcbench: matrix-palette vertex shader (test G2). Each vertex selects a 3x4 matrix from a palette of 28 in float
; uniforms through a per-vertex index (v3.x = 3 * matrix number), as a GameCube position-matrix index would.
; Inputs: v0 position xyz (float), v1 color (u8x4), v2 uv (float), v3 palette offset (float).

.fvec projection[4]
.fvec pal[84]

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2
.alias inidx v3

.proc main
	mova a0.x, inidx
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, pal[a0.x], r0
	dp4 r1.y, pal[a0.x+1], r0
	dp4 r1.z, pal[a0.x+2], r0
	mov r1.w, ones

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul outclr, inv255, inclr
	mov outtc0, intc
	end
.end
