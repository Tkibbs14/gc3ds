+#if defined(__3DS__)
+extern "C" uint64_t gc3ds_ticks(void);
+extern "C" void gc3ds_dl_account(uint32_t bytes, uint64_t ticks);
+#endif
 void GXCallDisplayList(const void* data, u32 nbytes) {
   // Flush any pending dirty state before calling
