+#else
   aurora::gx::fifo::write_data(data, nbytes);
+#endif
+#if defined(__3DS__)
+  gc3ds_dl_account(nbytes, gc3ds_ticks() - gc3dsT0);  // gc3ds native mode: list copies' bytes and time
+#endif
   aurora::gx::fifo::publish();
 }
 
