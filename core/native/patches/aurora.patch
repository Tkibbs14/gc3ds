@@ -58,7 +62,19 @@ void GXCallDisplayList(const void* data, u32 nbytes) {
   }
 
   // Write display list contents to the FIFO
+#if defined(__3DS__)
+  const uint64_t gc3dsT0 = gc3ds_ticks();
+#endif
+#if defined(__3DS__)
+  GX_WRITE_AURORA(0x0060);  // gc3ds native mode: CALL_DL by reference (u64 pointer, u32 size)
