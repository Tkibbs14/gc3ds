; gc3ds GX backend vertex shader (generated by core/tools/gen_gxpass.sh; edit that).
; Vertices arrive transformed on the CPU (gx/vfast.c): v0 clip position, v1 colour (u8x4), v2-v4 texture coordinates.
; With lon.z = 1 the shader lights the colour channel the PICA receives, from the eight GX lights, exactly as
; vfast_gpu_light_model (the C model the PC checks against the reference): v1 is then the raw vertex colour, v5 the
; eye-space position and v6 the eye-space normal (normalised here). Uniform layout: VLightUniforms in gx/vfast.h.

.fvec lights[40]
.fvec lsel[4]
.fvec lmat, lamb, lvsel, lon  ; lon: (colour half lit, alpha half lit, light this batch, 0)


.constf myconst(0.0, 1.0, 0.00392156862745098, 1.0e18)
.alias  zeros  myconst.xxxx
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz
.alias  big    myconst.wwww  ; reciprocals are clamped to +-big: an unused term must stay finite so that 0 * it is 0

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.proc main
	mov outpos, v0
	mov outtc0, v2
	mov outtc1, v3
	mov outtc2, v4
	mul r15, inv255, v1
	; lon.z = 1: the shader lights this batch (a float flag tested with cmp; a bool uniform did not reach the shader)
	mov r14, ones
	cmp lon.zzzz, eq, eq, r14
	ifc cmp.x
	mov r10.xyz, v6
	mov r10.w, zeros
	dp3 r0.x, r10, r10
	rsq r0.x, r0.x
	min r0.x, big, r0.x
	mul r10.xyz, r10.xyz, r0.xxxx
	mov r11, zeros
	; ---- light 0: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[0], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[1], r0
	dp3 r2.w, lights[1], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[3], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[4], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[3], r6
	dp3 r4.w, lights[4], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[3].wwww, r13.x
	mul r13.y, lights[4].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[2], r11
	mad r11.w, r13.yyyy, lights[2], r11
	; ---- light 1: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[5], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[6], r0
	dp3 r2.w, lights[6], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[8], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[9], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[8], r6
	dp3 r4.w, lights[9], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[8].wwww, r13.x
	mul r13.y, lights[9].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[7], r11
	mad r11.w, r13.yyyy, lights[7], r11
	; ---- light 2: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[10], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[11], r0
	dp3 r2.w, lights[11], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[13], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[14], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[13], r6
	dp3 r4.w, lights[14], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[13].wwww, r13.x
	mul r13.y, lights[14].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[12], r11
	mad r11.w, r13.yyyy, lights[12], r11
	; ---- light 3: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[15], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[16], r0
	dp3 r2.w, lights[16], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[18], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[19], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[18], r6
	dp3 r4.w, lights[19], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[18].wwww, r13.x
	mul r13.y, lights[19].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[17], r11
	mad r11.w, r13.yyyy, lights[17], r11
	; ---- light 4: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[20], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[21], r0
	dp3 r2.w, lights[21], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[23], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[24], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[23], r6
	dp3 r4.w, lights[24], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[23].wwww, r13.x
	mul r13.y, lights[24].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[22], r11
	mad r11.w, r13.yyyy, lights[22], r11
	; ---- light 5: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[25], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[26], r0
	dp3 r2.w, lights[26], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[28], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[29], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[28], r6
	dp3 r4.w, lights[29], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[28].wwww, r13.x
	mul r13.y, lights[29].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[27], r11
	mad r11.w, r13.yyyy, lights[27], r11
	; ---- light 6: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[30], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[31], r0
	dp3 r2.w, lights[31], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[33], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[34], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[33], r6
	dp3 r4.w, lights[34], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[33].wwww, r13.x
	mul r13.y, lights[34].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[32], r11
	mad r11.w, r13.yyyy, lights[32], r11
	; ---- light 7: L, distance, diffuse, spot and specular attenuation, then both halves
	add r0, lights[35], -v5
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[36], r0
	dp3 r2.w, lights[36], r10
	max r2.w, zeros, r2.w
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[38], r3
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[39], r5
	mov r6.x, ones
	mov r6.y, r2.w
	mul r6.z, r2.w, r2.w
	dp3 r4.z, lights[38], r6
	dp3 r4.w, lights[39], r6
	max r4.xz, zeros, r4
	rcp r7.x, r4.y
	rcp r7.y, r4.w
	min r7.xy, big, r7
	max r7.xy, -big, r7
	mul r7.z, r4.x, r7.x
	mul r7.w, r4.z, r7.y
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, r7.w
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	dp3 r12.z, lsel[2], r8
	dp3 r12.w, lsel[3], r9
	mul r13.x, r12.x, r12.y
	mul r13.y, r12.z, r12.w
	mul r13.x, lights[38].wwww, r13.x
	mul r13.y, lights[39].wwww, r13.y
	mad r11.xyz, r13.xxxx, lights[37], r11
	mad r11.w, r13.yyyy, lights[37], r11
	; material and ambient from the register or the vertex colour; lit halves clamp ambient + lights to 0..1
	add r0, -lmat, r15
	mul r1, lvsel.xxxy, r0
	add r1, lmat, r1
	add r0, -lamb, r15
	mul r2, lvsel.zzzw, r0
	add r2, lamb, r2
	add r3, r2, r11
	max r3, zeros, r3
	min r3, ones, r3
	add r3, -ones, r3
	mul r3, lon.xxxy, r3
	add r3, ones, r3
	mul outclr, r1, r3
	.else
	mov outclr, r15
	.end
	end
.end
