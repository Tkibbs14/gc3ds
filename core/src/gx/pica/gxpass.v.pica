; gc3ds GX backend vertex shader: vertices arrive already transformed and lit on the CPU (gx/xform.c), so this only
; passes them through. Inputs: v0 clip position (float4), v1 colour (u8x4, 0..255), v2-v4 texture coordinates for
; PICA texture units 0-2 (float2).

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  inv255 myconst.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.proc main
	mov outpos, v0
	mul outclr, inv255, v1
	mov outtc0, v2
	mov outtc1, v3
	mov outtc2, v4
	end
.end
