; gc3ds GX backend vertex shader (generated by core/tools/gen_gxpass.sh; edit that).
; v0 is the position. With lon.w = 1 the shader transforms it (gx/vfast.c vfast_job_gpu_pos): v0.xyz relative to the
; draw's origin, which the palette matrices carry in their translation (vfast_job_origin),
; v0.w = 3 * the palette slot of its position matrix, clip = proj * (pal[v0.w .. v0.w + 2] * v0.xyz), as
; vfast_gpu_pos_model (the C model the PC checks against the reference); otherwise v0 is the clip position the CPU
; computed. v1 colour (u8x4), v2-v4 texture coordinates.
; With lon.z = 1 the shader lights the colour channel the PICA receives, from the eight GX lights, exactly as
; vfast_gpu_light_model, for the cases vfast_gpu_light sends: colour half lit with attenuation none or spot, alpha
; half unlit or lit as the colour half. v1 is then the raw vertex colour and v6 the eye-space normal (normalised
; here); the eye-space position is the shader's own (lon.w = 1) or v5. Uniform layout: VLightUniforms in gx/vfast.h.
; Float uniforms: 48 lighting + 4 projection + 42 palette (14 matrices) + 1 constant, of the PICA's 96.

.fvec lights[40]
.fvec lsel[4]
.fvec lmat, lamb, lvsel, lon  ; lon: (colour half lit, alpha half lit, light this batch, transform this batch)
.fvec proj[4]
.fvec pal[42]


.constf myconst(0.0, 1.0, 0.00392156862745098, 1.0e18)
.alias  zeros  myconst.xxxx
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz
.alias  big    myconst.wwww  ; reciprocals are clamped to +-big: an unused term must stay finite so that 0 * it is 0

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.proc main
	; float flags tested with cmp (a bool uniform did not reach the shader): cmp.x lon.z = 1, the shader lights this
	; batch; cmp.y lon.w = 1, it transforms this batch. r6 holds the eye-space position for the lighting.
	mov r14, ones
	cmp lon.zwzw, eq, eq, r14
	ifc cmp.y
	mova a0.x, v0.w
	mov r6.xyz, v0.xyz
	mov r6.w, ones
	dp4 r5.x, pal[a0.x], r6
	dp4 r5.y, pal[a0.x+1], r6
	dp4 r5.z, pal[a0.x+2], r6
	mov r5.w, ones
	dp4 outpos.x, proj[0], r5
	dp4 outpos.y, proj[1], r5
	dp4 outpos.z, proj[2], r5
	dp4 outpos.w, proj[3], r5
	mov r6, r5
	.else
	mov outpos, v0
	mov r6, v5
	.end
	mov outtc0, v2
	mov outtc1, v3
	mov outtc2, v4
	mul r15, inv255, v1
	ifc cmp.x
	mov r10.xyz, v6
	mov r10.w, zeros
	dp3 r0.x, r10, r10
	rsq r0.x, r0.x
	min r0.x, big, r0.x
	mul r10.xyz, r10.xyz, r0.xxxx
	mov r11, zeros
	; ---- light 0: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[0], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[1], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[3], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[4], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[3].wwww, r13.x
	mad r11, r13.xxxx, lights[2], r11
	; ---- light 1: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[5], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[6], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[8], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[9], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[8].wwww, r13.x
	mad r11, r13.xxxx, lights[7], r11
	; ---- light 2: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[10], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[11], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[13], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[14], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[13].wwww, r13.x
	mad r11, r13.xxxx, lights[12], r11
	; ---- light 3: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[15], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[16], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[18], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[19], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[18].wwww, r13.x
	mad r11, r13.xxxx, lights[17], r11
	; ---- light 4: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[20], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[21], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[23], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[24], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[23].wwww, r13.x
	mad r11, r13.xxxx, lights[22], r11
	; ---- light 5: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[25], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[26], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[28], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[29], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[28].wwww, r13.x
	mad r11, r13.xxxx, lights[27], r11
	; ---- light 6: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[30], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[31], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[33], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[34], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[33].wwww, r13.x
	mad r11, r13.xxxx, lights[32], r11
	; ---- light 7: L, distance, diffuse, spot attenuation (vfast_gpu_light only sends attenuation none or spot, and an
	; alpha half that is unlit or lit exactly as the colour half, so one factor lights all four components)
	add r0, lights[35], -r6
	dp3 r1.x, r0, r0
	rsq r1.y, r1.x
	min r1.y, big, r1.y
	mul r1.z, r1.x, r1.y
	mul r0, r0, r1.yyyy
	dp3 r2.x, r10, r0
	max r2.y, zeros, r2.x
	dp3 r2.z, -lights[36], r0
	mov r3.x, ones
	mov r3.y, r2.z
	mul r3.z, r2.z, r2.z
	dp3 r4.x, lights[38], r3
	max r4.x, zeros, r4.x
	mov r5.x, ones
	mov r5.y, r1.z
	mov r5.z, r1.x
	dp3 r4.y, lights[39], r5
	rcp r7.x, r4.y
	min r7.x, big, r7.x
	max r7.x, -big, r7.x
	mul r7.z, r4.x, r7.x
	mov r8.x, ones
	mov r8.y, r2.x
	mov r8.z, r2.y
	mov r9.x, ones
	mov r9.y, r7.z
	mov r9.z, zeros
	dp3 r12.x, lsel[0], r8
	dp3 r12.y, lsel[1], r9
	mul r13.x, r12.x, r12.y
	mul r13.x, lights[38].wwww, r13.x
	mad r11, r13.xxxx, lights[37], r11
	; material and ambient from the register or the vertex colour; lit halves clamp ambient + lights to 0..1
	add r0, -lmat, r15
	mul r1, lvsel.xxxy, r0
	add r1, lmat, r1
	add r0, -lamb, r15
	mul r2, lvsel.zzzw, r0
	add r2, lamb, r2
	add r3, r2, r11
	max r3, zeros, r3
	min r3, ones, r3
	add r3, -ones, r3
	mul r3, lon.xxxy, r3
	add r3, ones, r3
	mul outclr, r1, r3
	.else
	mov outclr, r15
	.end
	end
.end
